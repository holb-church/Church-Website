---
<ul class="socials">
  {links.map(([key, url]) => (
    <li><a href={url} target="_blank" rel="noopener" aria-label={`${site.fullName} on ${icons[key].label}`} title={icons[key].label}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d={icons[key].path} /></svg>
    </a></li>
  ))}
</ul>
