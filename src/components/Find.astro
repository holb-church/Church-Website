---
import { site, fullAddress, mapsLink, mapsEmbed, telLink } from '../site.config.mjs';
const { id = 'find', tint = false, routes = false } = Astro.props;
---
<section class:list={['section', { tint }]} id={id}>
  <div class="wrap two find">
    <div class="stack-lg">
      <div class="stack">
        <span class="label">Find the house</span>
        <h2>6625 Fraser <em>Street.</em></h2>
      </div>
      <dl class="facts">
        <div><dt>When</dt><dd>{site.services[0].label}</dd></div>
        <div><dt>Where</dt><dd><a href={mapsLink} target="_blank" rel="noopener">{fullAddress}</a></dd></div>
        <div><dt>Parking</dt><dd>Plenty of free street parking nearby</dd></div>
        <div><dt>Transit</dt><dd>Buses run along Fraser Street, close to the door</dd></div>
        {site.phone && <div><dt>Call</dt><dd><a href={telLink}>{site.phone}</a></dd></div>}
        <div><dt>Write</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      </dl>
      <a class="btn btn-line" href={mapsLink} target="_blank" rel="noopener">Get directions</a>
    </div>
    <div class="frame map">
      <iframe src={mapsEmbed} title={`Map showing ${fullAddress}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
  {routes && (
    <div class="wrap routes">
      <h3>Getting here by transit</h3>
      <ul>
        {site.transit.map((r) => (
          <li>
            <span class="label">{r.line}</span>
            <strong>From {r.from}</strong>
            <p>{r.steps}</p>
          </li>
        ))}
      </ul>
      <p class="soft">We are on Fraser Street between 50th and 51st Avenue. For live times and any detours, tap Get directions or use the Transit app.</p>
    </div>
  )}
</section>
