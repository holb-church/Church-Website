---
import { site, fullAddress, mapsLink, mapsEmbed, telLink } from '../site.config.mjs';
---
<section class="section">
  <div class="wrap two">
    <div class="stack-lg">
      <div class="stack">
        <span class="label">Find the house</span>
        <h2>6625 Fraser <em>Street.</em></h2>
      </div>
      <dl class="facts">
        <div><dt>When</dt><dd>{site.services[0].label}</dd></div>
        <div><dt>Where</dt><dd><a href={mapsLink} target="_blank" rel="noopener">{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}</a></dd></div>
        <div><dt>Call</dt><dd><a href={telLink}>{site.phone}</a></dd></div>
        <div><dt>Write</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      </dl>
      <a class="arrow" href={mapsLink} target="_blank" rel="noopener">Get directions</a>
    </div>
    <div class="frame map">
      <iframe src={mapsEmbed} title={`Map showing ${fullAddress}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>
