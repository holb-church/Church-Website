---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found." noindex>
  <section class="opener">
    <div class="wrap">
      <span class="label">Page not found</span>
      <h1>This seat <em>is empty.</em></h1>
      <p class="lede">The page you were looking for has moved or never existed. Yours is still waiting, though.</p>
      <div class="actions"><a class="btn" href="/">Back to home</a><a class="arrow" href="/visit">Plan a visit</a></div>
    </div>
  </section>
</Base>
