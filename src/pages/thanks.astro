---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Your message has been sent." noindex>
  <section class="opener">
    <div class="wrap">
      <span class="label">Message sent</span>
      <h1>Got it. <em>Thank you.</em></h1>
      <p class="lede">Your message is with us, and someone from the church will be in touch soon.</p>
      <div class="actions"><a class="btn" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
